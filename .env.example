# =============================================================================
# fdroid-store global configuration
# Copy to .env and adapt
# =============================================================================

# ----- Public URLs ------------------------------------------------------------
# The F-Droid repo URL that will be served to F-Droid clients.
# Must be reachable from Android devices. HTTPS strongly recommended in prod.
PUBLIC_REPO_URL=http://localhost:8080/fdroid/repo
# Frontend public URL (used in emails, OAuth redirect_uri etc.)
PUBLIC_APP_URL=http://localhost:3000
# Backend API URL as seen by the browser
PUBLIC_API_URL=http://localhost:8000

# ----- Database ---------------------------------------------------------------
POSTGRES_USER=fdroid
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=fdroid
DATABASE_URL=postgresql+asyncpg://fdroid:changeme_postgres@postgres:5432/fdroid

# ----- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ----- Backend secrets --------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_with_a_long_random_string_at_least_64_chars_long
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ----- First admin user (created on first boot if no users exist) -------------
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=changeme_admin

# ----- Storage backend --------------------------------------------------------
# local | s3
STORAGE_BACKEND=local
# Local storage root (inside the container)
LOCAL_STORAGE_PATH=/data/storage

# S3 settings (only used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=fdroid-store
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# ----- F-Droid repo metadata --------------------------------------------------
REPO_NAME=My F-Droid Repo
REPO_DESCRIPTION=A self-hosted F-Droid repository
REPO_ICON=fdroid-icon.png

# ----- Keystore (the repo signing key) ----------------------------------------
# Path inside the container where the keystore lives.
# Will be auto-generated on first setup if it does not exist (and setup wizard
# chose "generate"). If you import your own, mount it as a volume.
KEYSTORE_PATH=/data/keystores/repo.p12
KEYSTORE_PASSWORD=changeme_keystore
KEY_ALIAS=repokey
KEY_PASSWORD=changeme_key
# Distinguished Name used when auto-generating the key
KEY_DNAME=CN=fdroid-store, OU=Self-hosted, O=Self, L=City, ST=State, C=US

# ----- Auth -------------------------------------------------------------------
# Comma-separated list of enabled auth methods: local,oidc
AUTH_METHODS=local
# Allow new user signup via the frontend
ALLOW_SIGNUP=true

# ----- OIDC (only used when "oidc" is in AUTH_METHODS) ------------------------
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Optional: map an OIDC claim to admin role. Format: claim=value
# Example: OIDC_ADMIN_CLAIM=groups=fdroid-admins
OIDC_ADMIN_CLAIM=

# ----- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ----- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
