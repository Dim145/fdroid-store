# nginx config baked into the frontend image. Processed with envsubst at
# container start by the official nginx image's entrypoint
# (20-envsubst-on-templates.sh). Only the variables matched by
# ``NGINX_ENVSUBST_FILTER`` (see the Dockerfile) are substituted, so the
# nginx ``$variables`` below are never touched. This single file works for
# both the bundled docker-compose deployment and any external host that
# exports a different ``UPSTREAM_BACKEND``.
#
# The image serves three things on the same port:
#   * static SPA pages from /usr/share/nginx/html (with SPA-style fallback)
#   * /api/, /fdroid/repo/, /r/ reverse-proxied to the FastAPI backend
#   * /_protected/ as an internal X-Accel-Redirect target for /data/storage
#
# Variables consumed (defaults + validation: docker-entrypoint.d/*.envsh):
#   UPSTREAM_BACKEND     "host:port" of the backend service. Default in
#                        docker-compose: ``backend:8000``.
#   ENABLE_HSTS          "1" to emit ``Strict-Transport-Security``. Off by
#                        default so plain-HTTP local development works.
#                        Production deployments behind TLS should turn it
#                        on (or set it at their upstream TLS terminator).
#   HSTS_MAX_AGE         seconds for HSTS. Defaults to 31536000 (1y).
#   TRUSTED_PROXY_CIDRS  IPs/CIDRs (comma or space separated) of the reverse
#                        proxy in front of this container, whose
#                        X-Forwarded-For is trusted for the client IP.
#                        Empty (default) = off, the TCP peer is the client.
#   NGINX_RESOLVER       DNS server(s) used to resolve UPSTREAM_BACKEND.
#                        Default 127.0.0.11 (Docker's embedded DNS).
#   API_MAX_BODY_SIZE    request-body cap for every route except the upload
#                        routes listed under /api/ below. Default 10m.
#   UPLOAD_MAX_BODY_SIZE request-body cap for those upload routes (APKs,
#                        media, backup restore). Default 2100m: the admin
#                        APK cap (upload_max_apk_mb) goes up to 2000 MB,
#                        plus multipart overhead.

# Docker's embedded DNS by default — refresh records every 10s so a backend
# restart doesn't strand a stale IP.
resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

# ---- Access log without credentials ---------------------------------------
# The path-token route carries a full API key in the URL (/r/<key>/…) and
# browser downloads carry a signed ``?t=<token>``. The stock ``$request``
# would log both verbatim — including /r/ APK downloads, which finish in the
# internal /_protected/ location after the backend's X-Accel-Redirect, so
# ``access_log off`` on /r/ alone never covered them. Same fields as the
# stock ``main`` format, with those two values masked.
map $request_uri $fdroid_log_uri_r {
    default $request_uri;
    "~*^(?<fdroid_lp>[^?]*?/(?:r|%72)/)[^/?]*(?<fdroid_ls>.*)$" "$fdroid_lp[redacted]$fdroid_ls";
}
map $fdroid_log_uri_r $fdroid_log_uri {
    default $fdroid_log_uri_r;
    "~*^(?<fdroid_lq>[^?]*\?(?:.*&)?(?:t|%74)=)[^&]*(?<fdroid_lt>.*)$" "$fdroid_lq[redacted]$fdroid_lt";
}
log_format fdroid_redacted '$remote_addr - $remote_user [$time_local] '
                           '"$request_method $fdroid_log_uri $server_protocol" '
                           '$status $body_bytes_sent "$http_referer" '
                           '"$http_user_agent" "$http_x_forwarded_for"';

server {
    listen 8080;
    server_name _;
    server_tokens off;
    access_log /var/log/nginx/access.log fdroid_redacted;

    # Request-body cap for every route except the upload routes nested under
    # /api/ below (UPLOAD_MAX_BODY_SIZE). Kept small so an unauthenticated
    # client can't push hundreds of MB into an arbitrary endpoint (FastAPI
    # reads a JSON body into memory before any auth dependency runs).
    client_max_body_size ${API_MAX_BODY_SIZE};

    gzip on;
    gzip_types text/plain application/json application/javascript text/css application/xml;
    gzip_min_length 1024;

    # Security headers applied to every response. The CSP forbids cross-origin
    # script and connect sources, so a hypothetical XSS sink can't ship the
    # JWT in localStorage to ``evil.com``. ``frame-ancestors 'none'`` makes
    # clickjacking of destructive actions (revoke key, delete app) impossible.
    # ``'unsafe-inline'`` is needed for the theme bootstrap script in
    # layout.tsx — replacing it with a nonce would require a server-side
    # render step that the static export doesn't have.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" always;
    # HSTS is gated on ``ENABLE_HSTS=1`` so local HTTP development isn't
    # locked into HTTPS the moment the browser caches the header. The
    # entrypoint shim (10-fdroid-hsts.sh) materialises this value at
    # container start: empty by default, ``add_header Strict-Transport-
    # Security "max-age=<HSTS_MAX_AGE>; includeSubDomains" always;`` when
    # the toggle is on. Production deployments behind TLS should turn it on.
    ${HSTS_DIRECTIVE}

    # NOTE: don't redefine ``types {}`` here — that would override the
    # http-level ``include /etc/nginx/mime.types`` and strip text/html,
    # text/css, … from the response, so browsers would download the SPA
    # instead of rendering it. The F-Droid-specific types (.apk, .jar)
    # only matter for the backend-proxied paths, and the backend already
    # sets the right Content-Type on those responses.

    root /usr/share/nginx/html;
    index index.html;

    # ---- Client IP behind a reverse proxy / CDN --------------------------
    # The proxied locations below set ``X-Forwarded-For $remote_addr`` so the
    # backend keys per-IP rate limits + audit logs on the TRUE client. When
    # this nginx is itself the edge that's correct. But behind BunkerWeb /
    # Traefik / a CDN, ``$remote_addr`` is the proxy's IP and every visitor
    # collapses into one rate-limit bucket (and audit logs lose the real IP).
    # Set TRUSTED_PROXY_CIDRS to that proxy's address(es), as seen by this
    # container, and the entrypoint shim renders here:
    #   set_real_ip_from <cidr>; …  real_ip_header X-Forwarded-For;
    #   real_ip_recursive on;
    # so ``$remote_addr`` (forwarded to the backend + logged) becomes the
    # client taken from the trusted proxy's X-Forwarded-For. Empty (default)
    # renders nothing. Never trust 0.0.0.0/0 (the shim refuses it): any
    # client could spoof its IP again.
    ${REAL_IP_DIRECTIVES}

    # ---- Backend reverse proxy -------------------------------------------
    # ``set`` + a variable in proxy_pass forces nginx to use the resolver
    # at request time instead of caching the IP at config-load (see comment
    # at the top of the file). Set once at server level: rewrite-module
    # directives aren't inherited by the nested location under /api/.
    set $upstream_backend ${UPSTREAM_BACKEND};

    # Never spool proxied bodies to disk. nginx-unprivileged keeps
    # client_body_temp_path / proxy_temp_path under /tmp — a 32 MB tmpfs in
    # the reference compose — so a buffered upload > ~32 MB (APK, backup
    # restore) failed with ENOSPC / 500, and a large buffered API response
    # (backup download) was truncated. Request bodies now stream to the
    # backend as they arrive; responses keep the small in-memory buffers and
    # past those nginx applies back-pressure instead of writing a temp file.
    proxy_request_buffering off;
    proxy_max_temp_file_size 0;

    location /api/ {
        proxy_pass http://$upstream_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # HTTP/1.1 upstream so a chunked upload streams too (with 1.0 nginx
        # must buffer a chunked body to compute its Content-Length).
        proxy_http_version 1.1;
        proxy_read_timeout 300;

        # Upload routes — the only ones allowed bodies above
        # API_MAX_BODY_SIZE. Every ``UploadFile`` endpoint of the backend:
        #   POST /api/v1/apks/inspect               APK (inspect + stage)
        #   POST /api/v1/apks/upload/{app_id}       APK (web UI + CI)
        #   POST /api/v1/apps/with-apk              APK (create app)
        #   POST /api/v1/apps/{id}/icon             image, 4 MiB
        #   POST /api/v1/apps/{id}/feature-graphic  image, 8 MiB
        #   POST /api/v1/apps/{id}/promo-graphic    image, 4 MiB
        #   POST /api/v1/apps/{id}/tv-banner        image, 12 MiB
        #   POST /api/v1/apps/{id}/screenshots      up to 20 x 12 MiB
        #   POST /api/v1/admin/repo/icon            image, 4 MiB
        #   POST /api/v1/admin/backup/restore       encrypted backup archive
        # A new upload endpoint must be added here, or it gets 413 above
        # API_MAX_BODY_SIZE. The backend still enforces its own per-route
        # caps (upload_max_apk_mb, media limits). Inherits everything above
        # except proxy_pass.
        location ~ ^/api/v1/(apks/(inspect|upload/[^/]+)|apps/(with-apk|[^/]+/(icon|feature-graphic|promo-graphic|tv-banner|screenshots))|admin/(repo/icon|backup/restore))/?$ {
            client_max_body_size ${UPLOAD_MAX_BODY_SIZE};
            proxy_pass http://$upstream_backend;
        }
    }

    location /fdroid/ {
        proxy_pass http://$upstream_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Large APK downloads: stream client-paced (no disk buffering of a
        # 300+ MB body) and give slow clients plenty of time — such a file
        # at a few Mb/s runs for many minutes. A too-short timeout here (or
        # in a proxy IN FRONT of this one) truncates the file mid-transfer,
        # which the browser reports as NS_BINDING_ABORTED. When
        # X_ACCEL_REDIRECT_ENABLED is on, APK bytes are served by the
        # /_protected/ location below instead of proxied from the backend.
        proxy_buffering off;
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
        send_timeout 3600;
    }

    # The path-token route puts the full API key in the URL path. Nginx
    # would otherwise log every request line — verbatim plaintext keys in
    # access logs is a bulk-credential leak waiting for one rolled log to
    # turn into account takeover for every F-Droid client. Turn the access
    # log off for the credential-bearing path (the server-level format masks
    # the key anyway); the backend still records authenticated downloads in
    # ``download_events``. error_log lines embed the raw request line (and
    # the upstream URL), which can't be masked, so only ``crit`` and above
    # are logged here; backend outages still show up via /api/ and /fdroid/.
    location /r/ {
        access_log off;
        error_log /var/log/nginx/error.log crit;
        proxy_pass http://$upstream_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Same large-download handling as /fdroid/ (this is the path-token
        # download route).
        proxy_buffering off;
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
        send_timeout 3600;
    }

    # Internal alias the backend redirects to via ``X-Accel-Redirect`` so
    # large APK downloads are streamed by nginx, not Python. Requires the
    # /data/storage volume to be mounted into this container.
    location /_protected/ {
        internal;
        alias /data/storage/;
        # Only APKs are routed here (via X-Accel-Redirect); label them and
        # let slow clients finish the (large) transfer.
        types { application/vnd.android.package-archive apk; }
        default_type application/octet-stream;
        send_timeout 3600;
        # The access log line is masked (server-level format), but a
        # "file not found" error_log line would carry the original request
        # line — /r/<key>/… for path-token downloads. The 404 itself is
        # still in the access log.
        log_not_found off;
    }

    # ---- Static SPA routing ----------------------------------------------
    # Dynamic segments under /apps/<pkg>/ and /my-apps/<id>/ are pre-rendered
    # as a single placeholder route at build time; nginx serves that
    # placeholder for any non-existent path so the client-side router can
    # take over and read the real segment from ``useParams()``.
    location /apps/ {
        try_files $uri $uri/index.html /apps/__dynamic/index.html;
    }
    location /my-apps/ {
        try_files $uri $uri/index.html /my-apps/__dynamic/index.html;
    }
    location /u/ {
        try_files $uri $uri/index.html /u/__dynamic/index.html;
    }
    # The admin Apps & APKs view ships a single ``/admin/apps/[package]/``
    # placeholder route which client-redirects to ``/admin/apps?app=<pkg>``.
    # Without this block, ``/admin/apps/org.foo.bar/`` would fall through
    # to the catch-all below and serve the home page — shared admin
    # deeplinks 404'd in practice. Order matters: the more specific
    # ``/admin/apps/`` prefix must come before the bare ``/admin/`` (and
    # before the default ``/``) location to win the regex match.
    location /admin/apps/ {
        try_files $uri $uri/index.html /admin/apps/__dynamic/index.html;
    }

    # Default: serve the file if it exists, otherwise its index.html, then
    # fall back to the SPA root.
    location / {
        try_files $uri $uri/index.html /index.html;
    }
}
